# ETVideoScript local/e2e configuration.
# Copy this file to `.env` at the repo root and fill real values locally.
# `.env` is gitignored. Do not commit real endpoints, credentials, or tokens.
# ETVS_* aliases are preferred; ETVIDEO_* keys remain supported for backward compatibility.

# Local API / web
ETVIDEO_WORKSPACE_ROOT=./workspaces
ETVIDEO_API_HOST=127.0.0.1
ETVIDEO_API_PORT=4317
ETVIDEO_ALLOWED_ORIGINS=http://127.0.0.1:4318,http://localhost:4318
NEXT_PUBLIC_ETVIDEO_API_URL=http://127.0.0.1:4317
# ETVS_WORKSPACE_ROOT=./workspaces
# ETVS_API_HOST=127.0.0.1
# ETVS_API_PORT=4317
# ETVS_ALLOWED_ORIGINS=http://127.0.0.1:4318,http://localhost:4318
# NEXT_PUBLIC_ETVS_API_URL=http://127.0.0.1:4317

# Trusted-local opt-in only. Terminal refuses non-local bind and requires this token.
ETVIDEO_ENABLE_TERMINAL=0
ETVIDEO_TERMINAL_TOKEN=<set-a-random-local-token>
# ETVS_ENABLE_TERMINAL=0
# ETVS_TERMINAL_TOKEN=<set-a-random-local-token>

# Transcription e2e. Configure locally in .env.
ETVIDEO_WHISPER_URL=http://127.0.0.1:8788/inference
ETVIDEO_WHISPER_BASIC_AUTH=<optional-basic-auth-value>
# ETVS_WHISPER_URL=http://127.0.0.1:8788/inference
# ETVS_WHISPER_BASIC_AUTH=<optional-basic-auth-value>

# Homelab TTS/voice-cloning e2e (tts.mlx-chatterbox), Mac Mini inference stack.
# ETVS_CHATTERBOX_BASE_URL=http://127.0.0.1:8791/v1/tts
# ETVS_CHATTERBOX_BASIC_AUTH=<optional-bearer-value, e.g. "Bearer <token>">
# ETVIDEO_CHATTERBOX_BASE_URL=http://127.0.0.1:8791/v1/tts
# ETVIDEO_CHATTERBOX_BASIC_AUTH=<optional-bearer-value, e.g. "Bearer <token>">

# Homelab denoise e2e (studio-sound.deepfilternet), Mac Mini inference stack.
# ETVS_DEEPFILTERNET_BASE_URL=http://127.0.0.1:8792/v1/enhance
# ETVS_DEEPFILTERNET_BASIC_AUTH=<optional-bearer-value, e.g. "Bearer <token>">
# ETVIDEO_DEEPFILTERNET_BASE_URL=http://127.0.0.1:8792/v1/enhance
# ETVIDEO_DEEPFILTERNET_BASIC_AUTH=<optional-bearer-value, e.g. "Bearer <token>">

# Demo escape hatch only: lets text-only Whisper output become approximate word timings.
ETVIDEO_ALLOW_APPROXIMATE_TRANSCRIPT=0
# ETVS_ALLOW_APPROXIMATE_TRANSCRIPT=0

# Replacement speech e2e.
# Required when selecting provider `xai` in the web UI.
XAI_API_KEY=<set-a-rotated-xai-key>
# Optional legacy alias also supported by the code.
GROK_API_KEY=
